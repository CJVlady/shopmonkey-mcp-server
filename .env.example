# Keep actual secrets out of git. Set these in Railway Variables.
SHOPMONKEY_API_KEY=
SHOPMONKEY_BASE_URL=https://api.shopmonkey.cloud/v3
SHOPMONKEY_LOCATION_ID=
# Public origin only; clients connect to this origin followed by /.
EXTERNAL_URL=https://your-service.up.railway.app
# Generate independent random secrets (32+ characters each).
OAUTH_SIGNING_SECRET=
OAUTH_PASSWORD=
# Optional static bearer credential for test/CLI clients.
MCP_AUTH_TOKEN=
# Initial rollout is read-only. Enable writes only after separate acceptance.
MCP_ENABLE_WRITES=false
